abbr_to_name <- setNames(state.name, state.abb)
abbr_to_name <- c(abbr_to_name, c(DC = "District Of Columbia"))
to_name <- function(s){
a <- toupper(str_trim(s))
out <- ifelse(a %in% names(abbr_to_name), abbr_to_name[a], str_to_title(a))
str_squish(out)
}
# ---------- READ ----------
